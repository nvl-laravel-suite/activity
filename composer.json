{
    "name": "nvl/activity",
    "description": "Activity capture and merged timelines for Laravel models",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "activity", "audit-log", "timeline"],
    "require": {
        "php": "^8.3",
        "ext-filter": "*",
        "ext-mbstring": "*",
        "laravel/framework": "^12.0 || ^13.0",
        "nesbot/carbon": "^2.72 || ^3.0",
        "nvl/data": "^1.0",
        "nvl/support": "^1.0",
        "spatie/laravel-activitylog": "^4.0 || ^5.0",
        "spatie/laravel-data": "^4.23",
        "spatie/typescript-transformer": "^3.3",
        "symfony/http-foundation": "^7.2 || ^8.0"
    },
    "require-dev": {
        "ext-pdo": "*",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "files": [
            "src/Support/activitylog_compatibility.php"
        ],
        "psr-4": {
            "Nvl\\Activity\\": "src/",
            "Nvl\\Activity\\Database\\Factories\\": "database/factories/",
            "Nvl\\Activity\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Activity\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Activity\\Providers\\ActivityServiceProvider"
            ],
            "aliases": []
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/tests"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
