includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    phpVersion: 80400
    excludePaths:
        analyseAndScan:
            - .temp/*

    paths:
        - src
        - database/factories
        - database/seeders
        - tests/Stubs/TestActivitySubjectWithHasModelActivity.php
        - tests/Stubs/TestActivityTimelineHost.php

    level: max

    checkModelProperties: true

    tmpDir: .temp/phpstan
